# MindsHub Cowork — environment
# Copy to .env (local) or paste these into Dokploy → Environment.
# Never commit the real .env. Only ANTON_MINDS_API_KEY is strictly required.

# --- Minds Cloud / MindsHub (primary auth) ---
# Get the key from your MindsHub / Minds Cloud account.
ANTON_MINDS_API_KEY=

# Leave empty to use the Minds cloud default endpoint.
# Set only if you point at a custom / self-hosted Minds server.
ANTON_MINDS_URL=

# Optional: pin a specific Mind on the Minds server.
# ANTON_MINDS_MIND_NAME=

# --- BYOK overrides (only if NOT routing through Minds) ---
# ANTON_PLANNING_PROVIDER=anthropic
# ANTON_ANTHROPIC_API_KEY=sk-ant-...
# ANTON_OPENAI_API_KEY=

# --- Server (defaults already set in compose; override only if needed) ---
# COWORK_SERVER_PORT=26866
